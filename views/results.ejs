<%- include('partials/head', { title: 'Resultados - ' + poll.title }) %>
<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm p-4">
            <h2 class="mb-4">Resultados: <%= poll.title %></h2>
            
            <% 
                let totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
            %>
            
            <% poll.options.forEach(option => { 
                let percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
            %>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span><strong><%= option.text %></strong></span>
                        <span><%= option.votes %> votos (<%= percentage %>%)</span>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= percentage %>%;" aria-valuenow="<%= percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            <% }) %>
            
            <div class="text-center mt-4">
                <a href="/" class="btn btn-secondary">Volver al Inicio</a>
                <a href="/poll/<%= poll.id %>" class="btn btn-primary ms-2">Votar otra vez</a>
            </div>
        </div>
    </div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
