<%- include('partials/head', { title: poll.title }) %>
<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow-sm p-4">
            <h2 class="mb-3"><%= poll.title %></h2>
            <form action="/poll/<%= poll.id %>/vote" method="POST">
                <% poll.options.forEach(option => { %>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="option_id" id="opt_<%= option.id %>" value="<%= option.id %>" required>
                        <label class="form-check-label fs-5" for="opt_<%= option.id %>">
                            <%= option.text %>
                        </label>
                    </div>
                <% }) %>
                <button type="submit" class="btn btn-success w-100 mt-3">Enviar Voto</button>
            </form>
        </div>
    </div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
