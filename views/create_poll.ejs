<%- include('partials/head', { title: 'Crear Encuesta' }) %>
<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow-sm p-4">
            <h2 class="mb-3 text-center">Crear Nueva Encuesta</h2>
            <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <form action="/poll/create" method="POST">
                <div class="mb-3">
                    <label for="title" class="form-label">Título de la Encuesta</label>
                    <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <hr>
                <label class="form-label">Opciones de Respuesta</label>
                <div class="mb-2">
                    <input type="text" class="form-control mb-2" name="options" placeholder="Opción 1" required>
                    <input type="text" class="form-control mb-2" name="options" placeholder="Opción 2" required>
                    <input type="text" class="form-control mb-2" name="options" placeholder="Opción 3 (Opcional)">
                    <input type="text" class="form-control mb-2" name="options" placeholder="Opción 4 (Opcional)">
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">Guardar Encuesta</button>
            </form>
        </div>
    </div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
